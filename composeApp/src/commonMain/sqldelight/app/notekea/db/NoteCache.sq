-- What Notekea last read from each note, so a vault opens without reading every file again. Rows are keyed by the
-- vault path and the note path inside it; tags and aliases keep their frontmatter order in `position`.

CREATE TABLE note_cache (
    vault TEXT NOT NULL,
    path TEXT NOT NULL,
    size INTEGER,
    modified_at INTEGER,
    title TEXT,
    PRIMARY KEY (vault, path)
);

CREATE TABLE note_cache_tag (
    vault TEXT NOT NULL,
    path TEXT NOT NULL,
    position INTEGER NOT NULL,
    tag TEXT NOT NULL,
    PRIMARY KEY (vault, path, position)
);

CREATE INDEX note_cache_tag_by_tag ON note_cache_tag (vault, tag);

CREATE TABLE note_cache_alias (
    vault TEXT NOT NULL,
    path TEXT NOT NULL,
    position INTEGER NOT NULL,
    alias TEXT NOT NULL,
    PRIMARY KEY (vault, path, position)
);

selectNotes:
SELECT path, size, modified_at, title FROM note_cache WHERE vault = ?;

selectTags:
SELECT path, tag FROM note_cache_tag WHERE vault = ? ORDER BY path, position;

selectAliases:
SELECT path, alias FROM note_cache_alias WHERE vault = ? ORDER BY path, position;

upsertNote:
INSERT OR REPLACE INTO note_cache (vault, path, size, modified_at, title) VALUES (?, ?, ?, ?, ?);

insertTag:
INSERT INTO note_cache_tag (vault, path, position, tag) VALUES (?, ?, ?, ?);

insertAlias:
INSERT INTO note_cache_alias (vault, path, position, alias) VALUES (?, ?, ?, ?);

deleteNote:
DELETE FROM note_cache WHERE vault = ? AND path = ?;

deleteTags:
DELETE FROM note_cache_tag WHERE vault = ? AND path = ?;

deleteAliases:
DELETE FROM note_cache_alias WHERE vault = ? AND path = ?;
