#!/bin/sh
# Formats the staged Kotlin files with ktlint and blocks the commit when lint or the unit tests fail.
# Installed automatically by the `installGitHooks` Gradle task (git config core.hooksPath .githooks).
# Skip only in an emergency with `git commit --no-verify`.
set -e

staged_kotlin_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.kt' '*.kts')

echo "pre-commit: running ktlintFormat"
./gradlew ktlintFormat --quiet

if [ -n "$staged_kotlin_files" ]; then
    # Re-stage the files ktlint may have reformatted so the commit contains the formatted version.
    echo "$staged_kotlin_files" | while IFS= read -r file; do
        if [ -f "$file" ]; then
            git add -- "$file"
        fi
    done
fi

# The fast checks: lint, the unit and architecture tests of the app, and the tools' own tests. The cases that drive
# the real app (`:auto-test:test`, about half an hour) and the coverage they complete run in CI and on demand
# (`./gradlew check koverVerify`): a hook that slow was skipped on every commit (the developer, 2026-11-14).
echo "pre-commit: running lint and the unit tests"
./gradlew ktlintCheck :app:jvmTest :ktlint-rules:test :test-buddy:test :test-buddy-crash:test --quiet
