-- What Notekea last read from each note, so a vault opens without reading every file again. Rows are keyed by the
-- vault path and the note path inside it; tags and aliases keep their frontmatter order in `position`.

CREATE TABLE note_cache (
    vault TEXT NOT NULL,
    path TEXT NOT NULL,
    size INTEGER,
    modified_at INTEGER,
    title TEXT,
    PRIMARY KEY (vault, path)
);

CREATE TABLE note_cache_tag (
    vault TEXT NOT NULL,
    path TEXT NOT NULL,
    position INTEGER NOT NULL,
    tag TEXT NOT NULL,
    PRIMARY KEY (vault, path, position)
);

CREATE INDEX note_cache_tag_by_tag ON note_cache_tag (vault, tag);

-- The `#tags` written in each note's text, apart from its frontmatter tags, in the order they first appear.
CREATE TABLE note_cache_text_tag (
    vault TEXT NOT NULL,
    path TEXT NOT NULL,
    position INTEGER NOT NULL,
    tag TEXT NOT NULL,
    PRIMARY KEY (vault, path, position)
);

CREATE TABLE note_cache_alias (
    vault TEXT NOT NULL,
    path TEXT NOT NULL,
    position INTEGER NOT NULL,
    alias TEXT NOT NULL,
    PRIMARY KEY (vault, path, position)
);

-- Each note's frontmatter properties in order, with their type (`CachedPropertyCodec`), for the vault's queries.
CREATE TABLE note_cache_property (
    vault TEXT NOT NULL,
    path TEXT NOT NULL,
    position INTEGER NOT NULL,
    property TEXT NOT NULL,
    type TEXT NOT NULL,
    value TEXT NOT NULL,
    PRIMARY KEY (vault, path, position)
);

-- Each note's tasks in text order, for the vault's Tasks tab.
CREATE TABLE note_cache_task (
    vault TEXT NOT NULL,
    path TEXT NOT NULL,
    position INTEGER NOT NULL,
    state_index INTEGER NOT NULL,
    end_index INTEGER NOT NULL,
    text TEXT NOT NULL,
    is_done INTEGER AS kotlin.Boolean NOT NULL,
    heading TEXT,
    date TEXT,
    PRIMARY KEY (vault, path, position)
);

selectNotes:
SELECT path, size, modified_at, title FROM note_cache WHERE vault = ?;

selectTags:
SELECT path, tag FROM note_cache_tag WHERE vault = ? ORDER BY path, position;

selectTextTags:
SELECT path, tag FROM note_cache_text_tag WHERE vault = ? ORDER BY path, position;

selectAliases:
SELECT path, alias FROM note_cache_alias WHERE vault = ? ORDER BY path, position;

selectProperties:
SELECT path, property, type, value FROM note_cache_property WHERE vault = ? ORDER BY path, position;

selectTasks:
SELECT path, state_index, end_index, text, is_done, heading, date FROM note_cache_task WHERE vault = ? ORDER BY path, position;

upsertNote:
INSERT OR REPLACE INTO note_cache (vault, path, size, modified_at, title) VALUES (?, ?, ?, ?, ?);

insertTag:
INSERT INTO note_cache_tag (vault, path, position, tag) VALUES (?, ?, ?, ?);

insertTextTag:
INSERT INTO note_cache_text_tag (vault, path, position, tag) VALUES (?, ?, ?, ?);

insertAlias:
INSERT INTO note_cache_alias (vault, path, position, alias) VALUES (?, ?, ?, ?);

insertProperty:
INSERT INTO note_cache_property (vault, path, position, property, type, value) VALUES (?, ?, ?, ?, ?, ?);

insertTask:
INSERT INTO note_cache_task (vault, path, position, state_index, end_index, text, is_done, heading, date)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteNote:
DELETE FROM note_cache WHERE vault = ? AND path = ?;

deleteTags:
DELETE FROM note_cache_tag WHERE vault = ? AND path = ?;

deleteTextTags:
DELETE FROM note_cache_text_tag WHERE vault = ? AND path = ?;

deleteAliases:
DELETE FROM note_cache_alias WHERE vault = ? AND path = ?;

deleteProperties:
DELETE FROM note_cache_property WHERE vault = ? AND path = ?;

deleteTasks:
DELETE FROM note_cache_task WHERE vault = ? AND path = ?;
